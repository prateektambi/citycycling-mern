/* --- Filter Bar Styles --- */
.filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    background: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border: 1px solid #eee;
    align-items: flex-end;
}

.filter-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-item label {
    font-weight: bold;
    font-size: 0.9rem;
    color: #555;
}

.filter-item select, .filter-item input {
    padding: 0.6rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
}

.height-inputs {
    display: flex;
    gap: 0.5rem;
}

/* Toggle Buttons for Availability */
.toggle-group {
    display: flex;
    border: 1px solid #ccc;
    border-radius: 4px;
    overflow: hidden;
}

.toggle-group button {
    padding: 0.6rem 1rem;
    border: none;
    background: white;
    cursor: pointer;
    font-size: 0.9rem;
    transition: 0.2s;
}

.toggle-group button.active {
    background: #007bff;
    color: white;
}

.toggle-group button:not(:last-child) {
    border-right: 1px solid #ccc;
}

.no-results {
    text-align: center;
    padding: 3rem;
    color: #888;
    grid-column: 1 / -1;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .filter-bar {
        flex-direction: column;
        align-items: stretch;
    }
}